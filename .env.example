# ITM Notes Environment Variables Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control!

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Public App URL (Used for auth redirects)
VITE_APP_URL=http://localhost:8080

# Web Push & Firebase Cloud Messaging (FCM) Configuration (A1)
# Required for real device push notification delivery on Web/PWA and Android.
# Web Push VAPID Public Key (Safe in client-side build)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-from-web-push

# Backend / Supabase Edge Function Secrets (Set in Supabase Dashboard / Vercel Environment, NOT in frontend build):
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@itm-notes.edu
# FCM_SERVER_KEY=your-firebase-cloud-messaging-server-key
